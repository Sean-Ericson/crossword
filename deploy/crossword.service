# systemd unit for the crossword server (Linux).
#   sudo cp deploy/crossword.service /etc/systemd/system/
#   edit User= and the paths below, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now crossword
[Unit]
Description=Crossword site (Node server)
After=network-online.target
Wants=network-online.target

[Service]
User=crossword
WorkingDirectory=/opt/crossword/crossword-site
ExecStart=/usr/bin/node server/server.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# e.g. Environment=XWORD_PYTHON=/opt/crossword/venv/bin/python

[Install]
WantedBy=multi-user.target
