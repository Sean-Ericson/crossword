# Copy to deploy/deploy.env (gitignored) and fill in.

# The public name the site is reached at. Caddy gets an HTTPS
# certificate for it from Let's Encrypt automatically.
XWORD_DOMAIN=yourname.duckdns.org

# DuckDNS (https://www.duckdns.org): the subdomain (without
# .duckdns.org) and the account token shown on the DuckDNS page.
DUCKDNS_SUBDOMAIN=yourname
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
